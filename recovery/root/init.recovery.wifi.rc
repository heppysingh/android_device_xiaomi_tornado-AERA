
on init
    mkdir /mnt/vendor/nvdata 0771 root system
    mount ext4 /dev/block/by-name/nvdata /mnt/vendor/nvdata
    mkdir /tmp/recovery 0775 root wifi
    mkdir /tmp/recovery/sockets 0770 wifi wifi
    chmod 0755 /vendor/bin/wmt_loader
    chmod 0755 /vendor/bin/wmt_launcher
    chmod 0755 /vendor/bin/wlan_assistant
   
service wpa_supplicant /system/bin/wpa_supplicant \
    -Dnl80211 -iwlan0 -c/tmp/recovery/wpa_supplicant.conf \
    -O/tmp/recovery/sockets
    class main
    user root
    group root wifi inet
    setenv LD_LIBRARY_PATH /vendor/lib64:/vendor/lib:/system/lib64:/system/lib:/sbin
    socket wpa_wlan0 dgram 660 wifi wifi
    disabled
    oneshot
    seclabel u:r:recovery:s0



service wlan_assistant /vendor/bin/wlan_assistant
    class main
    user wifi
    group root system gps inet wifi
    setenv LD_LIBRARY_PATH /vendor/lib64:/vendor/lib:/system/lib64:/system/lib:/sbin
    disabled
    seclabel u:r:recovery:s0

service wmt_loader /vendor/bin/wmt_loader
    class early_hal
    user root
    group root system
    setenv LD_LIBRARY_PATH /vendor/lib64:/vendor/lib:/system/lib64:/system/lib:/sbin
    disabled
    oneshot
    seclabel u:r:recovery:s0

service wmt_launcher /vendor/bin/wmt_launcher -p /vendor/firmware/ -o 1
    class early_hal
    user root
    group root system
    setenv LD_LIBRARY_PATH /vendor/lib64:/vendor/lib:/system/lib64:/system/lib:/sbin
    disabled
    seclabel u:r:recovery:s0

on property:sys.fox.wlan.up=1
    mkdir /tmp/recovery 0775 root wifi
    chown root wifi /tmp/recovery
    chmod 0775 /tmp/recovery
    mkdir /tmp/recovery/sockets 0770 wifi wifi
    chown wifi wifi /tmp/recovery/sockets
    chmod 0770 /tmp/recovery/sockets
    copy /system/etc/wifi/wpa_supplicant.conf /tmp/recovery/wpa_supplicant.conf
    chown wifi wifi /tmp/recovery/wpa_supplicant.conf
    chmod 0660 /tmp/recovery/wpa_supplicant.conf
    start wmt_loader
    start wmt_launcher
    wait_for_prop vendor.connsys.driver.ready yes
    start wlan_assistant
    write /dev/wmtWifi 1
    wait /sys/class/net/wlan0 5
    exec u:r:recovery:s0 root root -- /system/bin/ifconfig wlan0 up
    start wpa_supplicant
    setprop sys.fox.wlan.up 0

on property:vendor.connsys.driver.ready=yes
    start wlan_assistant

on property:hwservicemanager.ready=true && property:twrp.vintf.ready=1
    start wmt_loader
    start wmt_launcher
